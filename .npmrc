# Força a instalação das devDependencies mesmo com NODE_ENV=production.
# Necessário no build da Render/produção: o `nest build` (tsc) precisa do
# @nestjs/cli, typescript e dos @types/* — todos em devDependencies. Sem isto,
# `npm install` sob NODE_ENV=production os omite e o build falha com "nest: not found".
# `include` vence `omit` quando o mesmo tipo aparece nos dois (omit=dev vem do NODE_ENV).
include=dev
