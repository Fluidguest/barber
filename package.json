{
  "name": "barber-saas",
  "version": "0.0.1",
  "private": true,
  "description": "SaaS multi-tenant de gestão para barbearias — backend",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:migrate:status": "prisma migrate status",
    "db:rls": "docker exec -i barber_db psql -U barber_owner -d barber -v ON_ERROR_STOP=1 -f - < prisma/rls/enable-rls.sql",
    "db:constraints": "docker exec -i barber_db psql -U barber_owner -d barber -v ON_ERROR_STOP=1 -f - < prisma/constraints/business-rules.sql",
    "db:dev-password": "docker exec barber_db psql -U barber_owner -d barber -c \"ALTER ROLE app_role PASSWORD 'app_dev_pw';\"",
    "db:setup": "prisma migrate deploy && npm run db:rls && npm run db:constraints && npm run db:dev-password && prisma generate",
    "db:rls:psql": "psql \"$DIRECT_URL\" -v ON_ERROR_STOP=1 -f prisma/rls/enable-rls.sql",
    "db:constraints:psql": "psql \"$DIRECT_URL\" -v ON_ERROR_STOP=1 -f prisma/constraints/business-rules.sql",
    "db:setup:prod": "prisma migrate deploy && npm run db:rls:psql && npm run db:constraints:psql && prisma generate",
    "db:seed": "ts-node prisma/seed.ts",
    "platform:admin": "ts-node prisma/create-platform-admin.ts",
    "test:e2e": "jest --config test/jest-e2e.json --runInBand"
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "dependencies": {
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/platform-socket.io": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^10.4.22",
    "@prisma/client": "6.16.2",
    "@sentry/node": "^8.55.2",
    "argon2": "0.41.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "helmet": "8.0.0",
    "ioredis": "^5.11.1",
    "nestjs-pino": "^4.6.1",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/schematics": "10.2.3",
    "@nestjs/testing": "10.4.15",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@types/nodemailer": "^6.4.24",
    "@types/supertest": "6.0.2",
    "dotenv": "16.4.7",
    "jest": "29.7.0",
    "pino-pretty": "^13.1.3",
    "prisma": "6.16.2",
    "socket.io-client": "^4.8.3",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "typescript": "5.7.2"
  }
}
