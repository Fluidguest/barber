# App em runtime: conecta como app_role (sofre RLS). Ver prisma/rls/README.md
# Senha padrão de DEV (definida por `npm run db:dev-password`). Em produção,
# use uma senha forte — o boot recusa `app_dev_pw` quando NODE_ENV=production.
DATABASE_URL="postgresql://app_role:app_dev_pw@localhost:15432/barber?schema=public"

# Migrations / setup de RLS: conecta como dono do banco.
DIRECT_URL="postgresql://barber_owner:owner_dev_pw@localhost:15432/barber?schema=public"

REDIS_URL="redis://localhost:6379"

# Porta da API (default 3333).
PORT="3333"

# Origens permitidas no CORS (CSV). Em produção, a URL pública do frontend.
# OBRIGATÓRIO em produção e não pode apontar para localhost.
CORS_ORIGIN="http://localhost:3100,http://localhost:3000"

# --- Cookie do refresh token (sessão) ---
# lax    -> frontend e API no MESMO domínio registrável (app.x.com + api.x.com)
#           ou atrás do mesmo proxy. Padrão.
# none   -> frontend e API em domínios DIFERENTES (ex.: Vercel + Render).
#           Exige HTTPS (o `Secure` é forçado automaticamente).
# strict -> mais rígido; pode quebrar retorno de redirect externo.
COOKIE_SAMESITE="lax"
# Opcional: compartilhar o cookie entre subdomínios (ex.: ".barber.com").
COOKIE_DOMAIN=""

REMINDER_LEAD_HOURS="24"

# URL pública do frontend — usada nos links enviados por e-mail (reset de senha).
APP_URL="http://localhost:3100"

# Nível de log: fatal|error|warn|info|debug|trace (padrão: debug em dev, info em prod)
LOG_LEVEL="debug"

# --- Sentry (captura de erros) — opcional ---
# Sem DSN, nada é enviado (no-op). Com DSN, erros 5xx são reportados com
# contexto (barbearia, usuário, rota). Crie o projeto em sentry.io e cole o DSN.
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0"   # 0 = só erros; suba p/ amostrar performance
APP_RELEASE=""                  # opcional: versão do deploy (casa erro com release)

# Agendador da plataforma (lembretes automáticos + expiração de trial).
# Deixe ligado em produção. Vazio = ligado (exceto em teste).
SCHEDULER_ENABLED="true"

# --- Autenticação (JWT) ---
# OBRIGATÓRIO. Segredo forte (>= 32 chars). Ex.: openssl rand -base64 48
JWT_SECRET="troque_por_um_segredo_forte_de_32_chars_ou_mais"
JWT_ACCESS_TTL="900"       # validade do access token, em segundos (15 min)
REFRESH_TTL_DAYS="30"      # validade do refresh token, em dias

# Criptografia de campos sensíveis em repouso (LGPD) — use segredo forte em prod.
# OBRIGATÓRIO. >= 32 chars. Ex.: openssl rand -base64 48
ENCRYPTION_KEY="troque_por_um_segredo_forte_de_32_chars_ou_mais"

# Rate limiting (req/min por IP)
THROTTLE_LIMIT="300"
# Multi-instância: contador compartilhado no Redis. Sem isso, é por instância
# (memória). Usa REDIS_URL se esta não for definida.
THROTTLE_REDIS_URL=""

# ============================================================================
#  INTEGRAÇÕES (ver docs/INTEGRATIONS.md)
# ============================================================================

# --- WhatsApp: fake (default) | meta (oficial) | waha (não-oficial) ---
WHATSAPP_PROVIDER="fake"
# Token de verificação do webhook da Meta (você define; a Meta ecoa no setup):
WHATSAPP_VERIFY_TOKEN="troque_este_token"
# Meta Cloud API (oficial):
META_WHATSAPP_TOKEN=""
META_WHATSAPP_PHONE_ID=""
META_WHATSAPP_API_VERSION="v21.0"
# WAHA (self-hosted):
WAHA_URL=""
WAHA_SESSION="default"
WAHA_API_KEY=""

# --- E-mail: fake (default, só loga) | smtp ---
# Usado no "esqueci minha senha". Em produção use smtp (SES, Resend, Postmark...).
MAIL_PROVIDER="fake"
MAIL_HOST=""
MAIL_PORT="587"
MAIL_SECURE="false"          # true para porta 465 (TLS implícito)
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="Barber SaaS <nao-responda@seudominio.com>"
# Validade do link de redefinição de senha, em minutos.
RESET_TOKEN_TTL_MIN="60"

# --- Billing da plataforma (assinatura da barbearia): fake (default) | mercadopago ---
PLATFORM_PAYMENT_PROVIDER="fake"

# --- Pagamento no PDV (cobrança PIX do cliente final): fake (default) | mercadopago ---
# Preferencialmente configure POR BARBEARIA na tela de Configurações (cifrado).
# Estes valores são apenas fallback global.
PAYMENT_PROVIDER="fake"
MP_ACCESS_TOKEN=""
MP_WEBHOOK_SECRET=""

# --- Storage: local (default) | s3 (S3/R2/MinIO) ---
# Use "s3" quando rodar em MAIS DE UMA instância (disco local não é compartilhado).
STORAGE_PROVIDER="local"
STORAGE_DIR="storage"
# S3/R2/MinIO — obrigatórios quando STORAGE_PROVIDER=s3:
S3_ENDPOINT=""           # ex.: https://<conta>.r2.cloudflarestorage.com
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
S3_REGION="auto"         # "auto" no R2; a região real na AWS (ex.: sa-east-1)
S3_FORCE_PATH_STYLE="true"  # true no R2/MinIO; false na AWS S3

# --- Google Calendar (agenda) — pendente (ver docs/INTEGRATIONS.md) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
